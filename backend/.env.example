PORT=5000
CORS_ORIGIN=http://localhost:5173

# Option A: path to a service account JSON file (recommended for local dev)
GOOGLE_APPLICATION_CREDENTIALS=./firebase/serviceAccountKey.json

# Option B: individual credentials (useful for hosting providers / CI)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
